#======== AMREX ==========
amrex.fpe_trap_invalid=1
amrex.fpe_trap_zero=1
fpe_trap_overflow=1
amr.v = 0

# ======== TIME ==========
# stop_time is overridden per driver on the command line (see `run`)
max_step  = 1000000
stop_time = 0.1

# ======== DOMAIN ==========
geometry.is_periodic = 0
geometry.coord_sys   = 0
geometry.prob_lo     = -0.5
geometry.prob_hi     =  0.5
amr.n_cell           = 1024

# ======== GRID ==========
amr.max_level       = 0
amr.ref_ratio       = 2
amr.regrid_int      = 2
amr.blocking_factor = 8
amr.max_grid_size   = 128
amr.n_error_buf     = 0
amr.grid_eff        = 0.99
amr.subcycling_mode = None

# ======== GEOMETRY ==========
eb2.geom_type = all_regular

# ======== PARTICLES ==========
particles.do_particles = 0

# ======== OUTPUT ==========
amr.checkpoint_files_output = 0
amr.check_int               = -1
amr.plot_files_output = 1
amr.plot_int          = -1
# plot only the final state (stop_time varies; -1 disables per-time plots,
# the final plotfile is always written)
amr.plot_per          = 1e30

# ======== PROBLEM ==========
# mfp.lua is provided per run on the command line (see `run`)
