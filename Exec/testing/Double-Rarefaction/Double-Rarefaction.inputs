# ======== AMREX ==========
# trap any negative-sqrt / divide-by-zero immediately instead of
# propagating NaNs - this test is specifically about positivity
amrex.fpe_trap_invalid = 1
amrex.fpe_trap_zero = 1
amrex.fpe_trap_overflow = 1
amr.v = 0

# ======== TIME ==========
max_step  = 1000
stop_time = 0.2

# ======== DOMAIN ==========
geometry.is_periodic = 1 1 1
geometry.coord_sys   = 0
geometry.prob_lo     = -0.5 -0.05 -0.05
geometry.prob_hi     =  0.5  0.05  0.05
amr.n_cell           = 160 16 16

# ======== GRID ==========
amr.max_level       = 0
amr.blocking_factor = 8
amr.max_grid_size   = 16

# ======== OUTPUT ==========
amr.checkpoint_files_output = 0
amr.plot_files_output = 1
amr.plot_file         = plt
amr.plot_int          = -1
amr.plot_per          = 0.2

# ======== PROBLEM DESCRIPTION ==========
mfp.lua = "
dofile('problem_definition.lua')
"
