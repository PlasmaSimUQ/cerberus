#======== AMREX ==========
amrex.fpe_trap_invalid=1
amrex.fpe_trap_zero=1
amrex.fpe_trap_overflow=1
amr.v = 0

# ======== TIME ==========
max_step  = 1000000
stop_time = 1.0

# ======== DOMAIN ==========
geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0  # 0 => cart, 1 => RZ  2=>spherical

# lo. res.
# quarter domain: the x=0 and y=0 planes are symmetry planes (see the lua).
# so only the first quadrant is solved.  128^2 uniform = the finest dx (1/64) of the 32^2 + 2-level step-1 grid.
# finest dx (1/64) as the Thermal-RMI case (64x8 base + 3 levels on 8x1).
geometry.prob_lo     =      0.0  0.0
geometry.prob_hi     =      2.0  2.0
amr.n_cell           =      128  128

# ======== LOAD BALANCE ==========
amr.loadbalance_with_workestimates = 1
amr.loadbalance_level0_int = 10

# ======== GRID ==========
amr.max_level       = 0     # uniform grid: AMR prolongation across the driver/background jump puts e below the table floor (see lua header)
amr.ref_ratio       = 2 2 2 2 2 2 2 # refinement ratio
amr.regrid_int      = 2 2 2 2 2 2 2 # how often to regrid
amr.blocking_factor = 8
amr.max_grid_size   = 32
amr.n_error_buf     = 4 4 4 4 4 4 4 # number of buffer cells in error est
amr.grid_eff        = 0.75     # what constitutes an efficient grid
amr.subcycling_mode = Auto # time sub-cycling (Auto, None, Manual, Optimal)

# ======== GEOMETRY ==========
eb2.geom_type = all_regular
particles.do_particles = 0

# ======== OUTPUT ==========

# CHECKPOINT FILES
amr.checkpoint_files_output = 1
amr.check_file              = step3.chk    # root name of checkpoint file
amr.check_int               = -1
amr.check_per               = 0.05   # resumable: amr.restart = <chk dir>

# PLOTFILES
amr.plot_files_output = 1
amr.plot_file         = step3.plt     # root name of plotfile
amr.plot_int          = -1      # number of timesteps between plotfiles
amr.plot_per          = 0.05

# ======== PROBLEM DESCRIPTION ==========
# Note that the problem description is defined as a lua script
# Everything within the double quotes "..." must conform to lua standards
# Note that any strings should therefore be defined by single quotes '...'

mfp.lua = "
CASE_DIR = '..'
TWO_FLUID = true
BURN = true
DRIVER_VELOCITY = 3.0e5
DRIVER_TEMPERATURE = 1.0e6
dofile('../problem_definition.lua')
"
