# Standalone EBGeometry-backed STL reader.
# Included unconditionally (independent of USE_EB) so the STL signed-distance
# reader is available in fluid-only builds. The translation unit guards its
# body on AMREX_SPACEDIM > 1 and compiles to empty in 1D.

CEXE_headers += MFP_ebgeometry_stl.H
CEXE_sources += MFP_ebgeometry_stl.cpp

# Node-shared SDF support (Tier 1). Step 1: flat BVH + traversal (no MPI yet).
CEXE_headers += MFP_ebgeometry_nodeshared.H
CEXE_sources += MFP_ebgeometry_nodeshared.cpp

INCLUDE_LOCATIONS += $(TOP)/Source/modules/eb_geometry
VPATH_LOCATIONS   += $(TOP)/Source/modules/eb_geometry
